# =====================================================================
# Brydl Dashboard — Render environment variables (TEMPLATE)
# =====================================================================
# HOW TO USE: copy the block for your scenario, fill the <placeholders>,
# then paste into Render → your web service → Environment → "Bulk
# Edit" / "Add in bulk" (accepts KEY=VALUE lines). Single-value fields:
# add each row WITHOUT quotes. Saving redeploys the service.
#
# IMPORTANT: Render does NOT read a .env file from your repo — this is
# a template for the dashboard's env editor. Keep real secrets OUT of
# the repo (the .gitignore already blocks .env).
# =====================================================================


# ---------------------------------------------------------------------
# SCENARIO A — deployed with the Blueprint (render.yaml did the setup)
# Only these are MISSING. PYTHON_VERSION, SECRET_KEY, FLASK_ENV,
# BRYDL_AUTO_SCHEMA and DATABASE_URL are already set automatically —
# open Environment and VERIFY they exist; do not duplicate them here.
# ---------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=<your-gmail-address@gmail.com>
# Paystack Transfers (optional): set a sk_* secret to enable one-click
# Payouts on the Payments page. Leave EMPTY to use the bank-batch CSV
# flow. Webhooks (POST /webhooks/paystack) are signature-verified.
PAYSTACK_SECRET_KEY=
SMTP_PASSWORD=<16-char-Google-app-password>
MAIL_FROM="Brydl <<your-gmail-address@gmail.com>>"
USD_TO_NGN_RATE=<today's-rate-e.g.-1534>

# RedLab dynamic red-teaming (v14):
# Set REDLAB_ENABLED=true to expose /redlab/v1/* routes (default false).
REDLAB_ENABLED=false
# Dedicated 32-byte urlsafe-base64 Fernet key for encrypting client LLM
# API keys at rest. Generate via:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Multiple comma-separated keys enable zero-downtime key rotation (primary key first).
REDLAB_FERNET_KEY=<32-byte-base64-fernet-key>


# ---------------------------------------------------------------------
# SCENARIO B — web service created manually (no Blueprint)
# Paste ALL of this, then fill the two <placeholders>.
# ---------------------------------------------------------------------
# PYTHON_VERSION=3.11.6
# FLASK_ENV=production
# BRYDL_AUTO_SCHEMA=0
# Generate SECRET_KEY on your machine (never reuse a key):
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=<paste-the-64-hex-characters>
# Render dashboard -> brydl-postgres -> Connections -> INTERNAL Database URL:
# DATABASE_URL=postgres://brydl_user:PASSWORD@dpg-xxxx-a/brydl
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=<your-gmail-address@gmail.com>
# SMTP_PASSWORD=<16-char-Google-app-password>
# MAIL_FROM="Brydl <<your-gmail-address@gmail.com>>"
# USD_TO_NGN_RATE=<today's-rate-e.g.-1534>
# REDLAB_ENABLED=false
# REDLAB_FERNET_KEY=<32-byte-base64-fernet-key>


# ---------------------------------------------------------------------
# NOTES
# - DATABASE_URL on the WEB SERVICE must be the INTERNAL URL (same
#   region, free traffic). The EXTERNAL URL is only for YOUR laptop
#   (seed-admin, pg_dump). Never put the External URL in the service.
# - SMTP_PASSWORD is a Google APP password (myaccount.google.com/
#   apppasswords, needs 2-Step Verification on) — not your login.
# - USD_TO_NGN_RATE is display-only Naira; update the value any time
#   the rate moves — Save, no code change.
# - RECOMMENDED optional: SITE_URL (your public URL, no trailing
#   slash, e.g. https://brydl-dashboard-xxxx.onrender.com) — makes
#   notification emails clickable links. Without it, emails still send
#   but say to sign in without a link.
# SITE_URL=https://<your-service>.onrender.com
# - RECOMMENDED optional: BANK_ENC_KEY — dedicated Fernet key for
#   bank-number encryption (generate:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())").
#   Unset = derived from SECRET_KEY (works, but keep them independent).
# BANK_ENC_KEY=<the-Fernet-key>
# - RedLab Dynamic Red-Teaming (v14):
#   REDLAB_ENABLED=true              enables /redlab/v1/* routes
#   REDLAB_FERNET_KEY=<key>          dedicated encryption key for target LLM keys
#   REDLAB_FERNET_KEYS=<k1>,<k2>     comma-separated keys for zero-downtime rotation
#   REDLAB_MOCK_MODEL=1              enables offline mock LLM (testing only)
# - Optional: TASK_MAX_REJECTIONS (default 3) — a task rejected this
#   many times auto-returns to the pending pool.
# TASK_MAX_REJECTIONS=3
# - Optional: PREFERENCE_MIN_JUSTIFICATION (default 40) — minimum
#   characters for the written justification on RLHF preference tasks.
# PREFERENCE_MIN_JUSTIFICATION=40
# - Optional knobs that already have sane defaults (add ONLY if you
#   want to change them): BRYDL_TERMS_VERSION, UPLOAD_BATCH_LIMIT,
#   IMPORT_MAX_ROWS, IMPORT_MAX_BYTES, PAGINATION_PER_PAGE,
#   LOGIN_MAX_FAILURES, FORGOT_MAX_PER_WINDOW.
# - SMTP_STARTTLS: leave unset (default on, port 587). Set to 0 only
#   for providers on port 465.
# - Phase 10 knobs (all optional, sane defaults if unset):
#   API_RATE_LIMIT_PER_MINUTE=60     per API key minute cap
#   JOBS_ENABLED=1                   1 = in-process runner thread;
#                                    0 = web service runs no runner
#                                    (use with dedicated worker.py)
#   JOBS_POLL_SECONDS=30             how often the queue polls
#   JOB_MAX_ATTEMPTS=5               retry cap per job (1-20)
#   RECONCILE_MIN_AGE_SECONDS=600    Paystack reconcile sweep cutoff
#   REDIS_URL=redis://…              Optional Render Key Value / Redis
#                                    for shared counters; leave empty
#                                    for per-process counters (works
#                                    for a single-web-dyno launch).
# - After saving: Render redeploys -> check Logs for a clean boot
#   (no red lines) -> test Forgot password end to end.
# ---------------------------------------------------------------------
