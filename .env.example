# =====================================================================
# Brydl Dashboard — Local Development Environment Template
# =====================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
# =====================================================================

FLASK_ENV=development
SECRET_KEY=local-dev-secret-key-must-be-at-least-32-chars-long
BRYDL_AUTO_SCHEMA=1

# SQLite database file is created automatically under instance/
# DATABASE_URL=sqlite:///instance/brydl.db

# RedLab Dynamic Red-Teaming (v14):
REDLAB_ENABLED=true
REDLAB_MOCK_MODEL=1
REDLAB_FERNET_KEY=P2R_l8fQ4bZ7xJ9mK3nV5pS8tU2wY6aC_dEfGhIjKlM=

# Display Exchange Rate (USD to NGN)
USD_TO_NGN_RATE=1600

# Optional Email / SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM="Brydl Local <dev@brydl.local>"
